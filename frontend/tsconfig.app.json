{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias — mirrored in tsconfig.json so both the compiler and the
       editor resolve "@/...". The shadcn Vite guide pairs this with
       "baseUrl": ".", but TypeScript 6.0 (installed here) errors on baseUrl as
       deprecated; "paths" alone resolves relative to this file, so it is
       omitted rather than silenced with ignoreDeprecations. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting — CLAUDE.md §5.2 mandates strict plus the two flags below.
       The Vite template ships without "strict", so it is set explicitly. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
