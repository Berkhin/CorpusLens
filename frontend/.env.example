# Frontend configuration — optional. Copy to `frontend/.env` to change it.
#
# Vite exposes only variables prefixed `VITE_` to client code, and inlines them
# at build time rather than reading them at runtime: changing this value means
# rebuilding, not restarting.

# Origin of the FastAPI backend. Optional: the app defaults to this value.
# Change it only if you run uvicorn on a different port — and if you do, add the
# new Vite origin to CORPUSLENS_CORS_ALLOW_ORIGINS on the backend as well.
#
# An empty value is meaningful, not missing: it makes every request
# root-relative, i.e. same-origin. That is what the container build uses, where
# one FastAPI process serves both this bundle and the API on a single port.
VITE_API_BASE_URL=http://localhost:8000
