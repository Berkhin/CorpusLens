# Backend configuration — every value here is optional.
#
# The application runs with no configuration at all: each setting below is
# already its default, and this file exists to document what is tunable, not to
# be required. Copy it to a **repository-root** `.env` to change something:
#
#     cp backend/.env.example .env
#
# The root, not backend/, is where `pydantic-settings` looks — see `env_file` in
# `backend/app/core/config.py`. Every variable is prefixed `CORPUSLENS_` so that
# generic names like HOST and PORT cannot collide with another tool's.
#
# Definitions live in `backend/app/core/config.py`; that module is the source of
# truth and documents the reasoning behind each default.


# --- Server -----------------------------------------------------------------

# Interface to bind. Loopback by default, deliberately: this API has no
# authentication, so 0.0.0.0 would publish the corpus to every machine on the
# local network. The container image sets 0.0.0.0, where the container boundary
# is what limits reach.
#
# Read by `python -m app`. The plain `uvicorn` CLI ignores it — pass `--host`,
# or export UVICORN_HOST, which uvicorn reads natively.
CORPUSLENS_HOST=127.0.0.1
CORPUSLENS_PORT=8000

# Browser origins allowed to call the API. Comma-separated or a JSON array.
# Matches Vite's dev server, whose port is pinned with `strictPort` for this
# reason; change both together or the browser reports an opaque CORS failure.
CORPUSLENS_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# --- Data -------------------------------------------------------------------

# Root of the corpus produced by `scripts/ingest.py`. Images, the vector index,
# the projection, the analysis and the collections store are all derived from
# it, so relocating the corpus is this one line. Relative paths resolve against
# the process working directory; prefer an absolute one.
CORPUSLENS_DATA_DIR=./data

# Location of the embedded LanceDB directory, if it should NOT sit under
# CORPUSLENS_DATA_DIR — e.g. to keep the index on a faster disk than the JPEGs.
# Left unset, it is `${CORPUSLENS_DATA_DIR}/lancedb`, which is what the offline
# scripts in `scripts/` assume. Setting it means passing a matching `--data-dir`
# to those scripts yourself.
# CORPUSLENS_LANCEDB_URI=./data/lancedb

CORPUSLENS_LANCEDB_TABLE_NAME=images


# --- Model ------------------------------------------------------------------

# The CLIP bi-encoder used to embed text queries at search time.
#
# This MUST be the checkpoint the images were embedded with by
# `scripts/ingest.py`. A mismatch does not raise — it yields a "shared" space
# that isn't shared, and search silently degrades to noise. If you change it,
# re-run ingestion with the same value exported, and note that the scripts read
# the process environment rather than the `.env` file:
#
#     export CORPUSLENS_CLIP_MODEL_ID=...
#     python scripts/ingest.py --force
#
# This is a `sentence-transformers` model id, not a `transformers` one. The
# raw HF checkpoint `openai/clip-vit-base-patch32` is NOT a drop-in substitute:
# SentenceTransformer would load it as a generic mean-pooling encoder rather
# than a CLIP dual-encoder, and the resulting vectors are not comparable with
# the indexed ones. CLAUDE.md §3 pins the value below.
CORPUSLENS_CLIP_MODEL_ID=clip-ViT-B-32

# CPU is not a default but a constraint: CLAUDE.md §2 targets an Intel Mac, and
# "cpu" is the only accepted value. Any other makes startup fail validation.
CORPUSLENS_TORCH_DEVICE=cpu

# Cap on torch's intra-op threads. Unset lets torch decide; lower it if the API
# shares the machine with the dev server.
# CORPUSLENS_TORCH_NUM_THREADS=4


# --- Behaviour --------------------------------------------------------------

# Ceiling on how many images may sit in a collection other than their split, in
# total. Each override becomes an id literal in every subsequent filtered query,
# so the cost is linear: ~22 ms unfiltered, ~222 ms at this default, ~1.6 s at a
# full re-partition of the 8 000-row table.
CORPUSLENS_MAX_COLLECTION_OVERRIDES=1000

CORPUSLENS_LOG_LEVEL=INFO

# Compiled SPA to serve from the application root, so one port serves both the
# client and the API with no CORS hop. Unset in development, where Vite owns the
# client on :5173. The container image sets it.
# CORPUSLENS_FRONTEND_DIST_DIR=/app/frontend-dist
