# ---------------------------------------------------------------------------
# Data, models, and vector index — NEVER commit. Regenerate via scripts/.
# ---------------------------------------------------------------------------
data/
!data/**/.gitkeep
*.lance
*.lancedb
.lancedb/
lancedb/
**/lancedb/
*.parquet
*.arrow
*.feather

# Datasets & media
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
*.tiff
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
# Allow small repo assets (docs screenshots, favicons, logos)
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.svg
!frontend/public/**/*.svg
!frontend/public/**/*.png
!frontend/public/**/*.ico
!frontend/src/assets/**

# Model weights & caches
*.bin
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt
*.h5
.cache/
.huggingface/
huggingface/
transformers_cache/
sentence_transformers_cache/
torch_cache/
# Anchored to the repo root: an unanchored `models/` also swallowed
# backend/app/models/, the Pydantic layer required by CLAUDE.md §4.1.
# Downloaded weights live under data/ (ignored wholesale) anyway.
/models/

